# Environment configuration template
PROJECT_NAME="TrackJob — Smart Job Tracker & AI Interview Prep"
ENVIRONMENT="development"
DEBUG=True

# ==============================================================================
# Database Configuration: Dual-Database Strategy
# ==============================================================================
# OPTION 1: Local Docker PostgreSQL (Default for local development & offline testing)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=interview_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_tracker

# OPTION 2: Neon Serverless PostgreSQL (For Cloud staging / Production / Render deployment)
# Uncomment and replace with your Neon connection string:
# DATABASE_URL=postgresql://neondb_owner:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Security
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32bytes_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration: Dual Provider Strategy (Google Gemini API & Local Ollama)
# OPTION 1: Google Gemini API (Recommended: Free tier, high speed, structured schema output)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OPTION 2: Local Ollama (Offline fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
